{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: gcc.exe build active file",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Slimeworks Factory: build",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Slimeworks Factory: run",
            "type": "shell",
            "command": "${workspaceFolder}/Slimeworks-Factory.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Slimeworks Factory: rebuild before launch",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Slimeworks Factory: clean",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-Command", "Remove-Item -LiteralPath '${workspaceFolder}/Slimeworks-Factory.exe' -Force -ErrorAction SilentlyContinue"],
            "options": { "cwd": "${workspaceFolder}" }
        }
    ]
}
